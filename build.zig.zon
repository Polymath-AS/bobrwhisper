.{
    .name = .bobrwhisper,
    .version = "0.1.0",
    .fingerprint = 0xd8360594ece6e7b,
    .minimum_zig_version = "0.16.0",

    .dependencies = .{
        // whisper.cpp v1.9.2. Keep nix/deps.nix in step; the `dep-pins` flake
        // check fails if the rev or hash here is not mirrored there.
        .whisper = .{
            .url = "git+https://github.com/ggml-org/whisper.cpp#306c88f4d1286aec1bf96e544632897886af5501",
            .hash = "N-V-__8AAKtFZQKKnEaIgq64slwmJVLwca5fkteZI0LoU8mu",
            .lazy = true,
        },
        // llama.cpp b10405. Only ggml is used for transcription; the llama
        // library itself is for the app's LLM formatting.
        .llama = .{
            .url = "git+https://github.com/ggml-org/llama.cpp#e79e4bf660e19f2ad851e06c6913f7a8c5852621",
            .hash = "N-V-__8AAOuNCQq9rWVHqDNhLl3CMV63XKzbv4P3Iq6eDN3V",
            .lazy = true,
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "pkg",
        "src",
        "include",
        // Needed by `zig build test-libwhisper`, which links a C translation
        // unit against the library to check the ABI.
        "examples",
    },
}
